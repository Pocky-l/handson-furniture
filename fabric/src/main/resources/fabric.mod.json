{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${mod_url}",
    "issues": "${mod_url}/issues"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.pockyl.handson_furniture.fabric.HandsOnFurnitureFabric"],
    "client": ["com.pockyl.handson_furniture.fabric.HandsOnFurnitureFabricClient"],
    "fabric-gametest": ["com.pockyl.handson_furniture.fabric.FabricFurnitureTests"]
  },
  "mixins": ["handson_furniture.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "diegesis": ">=${diegesis_version}",
    "refurbished_furniture": ">=${refurbished_furniture_min_version}"
  }
}
